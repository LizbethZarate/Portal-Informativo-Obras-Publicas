@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="container d-flex flex-column justify-content-center align-items-center"
         style="min-height:100vh;">

        <div class="card p-4" style="max-width: 430px; width: 100%;">

            <h3 class="text-center mb-2">Recuperar Contraseña</h3>

            <p class="text-center text-muted mb-4">
                Ingresa tu correo para generar un enlace de recuperación.
            </p>

            <form asp-action="RecuperarPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-success">
                        @ViewBag.Mensaje
                    </div>
                }

                @if (ViewBag.EnlaceRecuperacion != null)
                {
                    <div class="alert alert-info">
                        <strong>Enlace generado:</strong>
                        <br />
                        <a href="@ViewBag.EnlaceRecuperacion">
                            Restablecer contraseña
                        </a>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <input name="email"
                           type="email"
                           class="form-control"
                           placeholder="ejemplo@email.com"
                           required />
                </div>

                <button type="submit" class="btn btn-dark w-100 mb-2">
                    Generar enlace
                </button>
            </form>

            <div class="text-center mt-2">
                <a asp-controller="Account"
                   asp-action="Login">
                    Volver al login
                </a>
            </div>

        </div>
    </div>
</body>
</html>