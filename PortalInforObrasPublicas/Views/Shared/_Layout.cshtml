<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PortalInforObrasPublicas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PortalInforObrasPublicas.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index" style="gap: 12px;">
                    <img src="~/img/logo.png" alt="Logo SITOP" style="height:60px;width:auto;">
                    <div class="d-flex flex-column">
                        <span class="sitop-title">SITOP</span>
                        <span class="sitop-desc">Sistema de información y transparencia<br />de obras públicas</span>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var usuario = Context.Session.GetString("Usuario");
                        var nombre = Context.Session.GetString("Nombre");
                        var rol = Context.Session.GetString("Rol");
                    }
                    <ul class="navbar-nav ms-auto">

                        @if (usuario == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                        else
                        {
                            @if (rol != null && rol.ToLower() == "administrador")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Obra" asp-action="Index">Obras</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reporte" asp-action="Index">Denuncias</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Obras Publicas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Nueva Denuncia</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="HistorialDenuncias">Mis Denuncias</a>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="nav-link fw-bold">@nombre</span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-danger ms-2" asp-controller="Account" asp-action="Logout">
                                    Cerrar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PortalInforObrasPublicas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
