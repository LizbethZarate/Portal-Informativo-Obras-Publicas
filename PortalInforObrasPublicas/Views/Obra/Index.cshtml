@model List<PortalInforObrasPublicas.Models.Obra>

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold">Gestión de Obras</h2>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Nueva Obra
                </a>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>CodigoSNIP</th>
                            <th>Ubicación</th>
                            <th>Estado</th>
                            <th>Presupuesto</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var obra in Model)
                        {
                            <tr>

                                <td>
                                    @if (obra.Imagenes != null && obra.Imagenes.Any())
                                    {
                                        <img src="@obra.Imagenes.First().RutaImagen"
                                             width="100"
                                             height="70"
                                             style="object-fit:cover;border-radius:10px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin imagen
                                        </span>
                                    }
                                </td>

                                <td>@obra.Nombre</td>
                                <td>@obra.CodigoSNIP</td>

                                <td>@obra.Ubicacion</td>

                                <td>
                                    <span class="badge bg-primary">
                                        @obra.Estado
                                    </span>
                                </td>

                                <td>
                                    S/ @obra.Presupuesto
                                </td>

                                <td>
                                    @obra.FechaInicio.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @(obra.FechaFin?.ToString("dd/MM/yyyy") ?? "—")
                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@obra.IdObra"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@obra.IdObra"
                                       class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>