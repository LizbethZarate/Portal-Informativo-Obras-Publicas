@model List<PortalInforObrasPublicas.Models.Obra>

<h2 class="mb-4">Gestión de Obras</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Nueva Obra
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Ubicación</th>
            <th>Estado</th>
            <th>Presupuesto</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var obra in Model)
        {
            <tr>
                <td>@obra.Nombre</td>
                <td>@obra.Ubicacion</td>
                <td>@obra.Estado</td>
                <td>S/ @obra.Presupuesto</td>

                <td>@obra.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td>
                    @(obra.FechaFin.HasValue
                                    ? obra.FechaFin.Value.ToString("dd/MM/yyyy")
                                    : "—")
            </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@obra.IdObra" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@obra.IdObra" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
                }
    </tbody>
</table>