@model PortalInforObrasPublicas.Models.Obra
@{
    ViewData["Title"] = "Detalle de Obra";
}

<div class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 py-3">
        <a href="@Url.Action("Index", "Obras")" class="text-sm text-gray-600 hover:text-blue-600 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            Volver al listado
        </a>
    </div>
</div>

<section class="hero-banner">
    <img src="https://images.unsplash.com/photo-1541888946425-d81bb19480c5?q=80&w=2070" alt="Banner Obra">
</section>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-16 relative z-10 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-10 gap-8">

        <div class="lg:col-span-7 space-y-6">
            <div class="card p-8">
                <span class="badge-blue">En Ejecución</span>
                <h2 class="text-3xl font-bold text-slate-900 mt-4 mb-4">@Model.Nombre</h2>
                <div class="flex items-center gap-2 text-gray-500 mb-6 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                    @Model.Ubicacion
                </div>
                <hr class="mb-6">
                <h3 class="font-bold mb-2">Descripción del Proyecto</h3>
                <p class="text-gray-600">Rehabilitación y mejoramiento de pistas, veredas, ciclovías y áreas verdes en la principal avenida del distrito.</p>
            </div>

            <div class="card p-8">
                <h3 class="font-bold mb-6">Avance de Obra</h3>
                <div class="flex justify-between items-end mb-2">
                    <span class="text-sm text-gray-500">Progreso actual</span>
                    <span class="text-2xl font-bold text-blue-600">45%</span>
                </div>
                <div class="progress-container">
                    <div class="progress-bar" style="width: 45%;"></div>
                </div>
            </div>

            <div class="report-box p-8">
                <h3 class="font-bold text-slate-900 mb-2">¿Detectaste algún problema?</h3>
                <p class="text-gray-600 mb-6">Si observas alguna irregularidad o falta de mantenimiento, puedes reportarlo directamente.</p>
                <button class="btn-dark w-full py-4">Reportar Problema</button>
            </div>
        </div>

        <aside class="lg:col-span-3 space-y-6">
            <div class="card p-6">
                <h3 class="font-bold mb-6">Información Técnica</h3>
                <div class="space-y-6 text-sm">
                    <div>
                        <p class="text-gray-400 uppercase text-[10px] font-bold">Presupuesto Total</p>
                        <p class="text-2xl font-bold text-emerald-500">S/ @Model.Presupuesto</p>
                    </div>
                    <div class="border-t pt-4">
                        <p class="text-gray-400 uppercase text-[10px] font-bold">Fecha de Inicio</p>
                        <p class="font-semibold">@Model.FechaInicio</p>
                    </div>
                    <div class="border-t pt-4">
                        <p class="text-gray-400 uppercase text-[10px] font-bold">Fecha de Finalización</p>
                        <p class="font-semibold">@Model.FechaFin</p>
                    </div>
                    <div class="border-t pt-4">
                        <p class="text-gray-400 uppercase text-[10px] font-bold">Duración Estimada</p>
                        <p class="font-semibold">16 meses</p>
                    </div>
                </div>
            </div>

            <div class="card p-6 bg-gray-50">
                <h4 class="text-xs font-bold mb-2">Fuente de Información</h4>
                <p class="text-[11px] text-gray-500">Datos integrados con Infobras de la Contraloría General de la República.</p>
            </div>
        </aside>
    </div>
</main>

@section Scripts {
    <script src="~/js/obra-detalle.js"></script>
}