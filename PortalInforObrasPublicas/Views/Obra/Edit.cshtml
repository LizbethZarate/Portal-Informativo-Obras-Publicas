@model PortalInforObrasPublicas.Models.Obra

<h2>Editar Obra</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="IdObra" />

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Ubicación</label>
        <input asp-for="Ubicacion" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Estado</label>
        <input asp-for="Estado" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Presupuesto</label>
        <input asp-for="Presupuesto" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fecha Inicio</label>
        <input asp-for="FechaInicio" type="date" class="form-control"
               value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
    </div>

    <div class="mb-3">
        <label>Fecha Fin</label>
        <input asp-for="FechaFin" type="date" class="form-control"
               value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
    </div>

    <button type="submit" class="btn btn-warning">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>