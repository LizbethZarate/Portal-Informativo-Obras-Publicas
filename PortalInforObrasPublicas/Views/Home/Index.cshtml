@model List<PortalInforObrasPublicas.Models.Obra>

@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/obra.css" />

<div class="hero">
    <div class="container">
        <h1 class="fw-bold">Sistema de Gestión de Obras Públicas</h1>
        <p>Consulta el estado de proyectos y reporta problemas.</p>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>Total de Obras</h6>
                    <h3>@Model.Count</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>En Ejecución</h6>
                    <h3>
                        @Model.Count(o => o.Estado == "En ejecución")
                    </h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>Inversión Total</h6>
                    <h3>
                        S/ @Model.Sum(o => o.Presupuesto).ToString("N2")
                    </h3>
                </div>
            </div>
        </div>
        <div class="search-box d-flex gap-2 mt-4">
            <input type="text" class="form-control" placeholder="Buscar por nombre o ubicación..." />
            <select class="form-select w-auto">
                <option>Todos</option>
                <option>En ejecución</option>
                <option>Finalizado</option>
            </select>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h4 class="fw-bold">Obras Públicas del Distrito</h4>

    <div class="row mt-4">

        @foreach (var obra in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card obra-card h-100">

                    @if (obra.Imagenes != null &&
                                    obra.Imagenes.Any())
                    {
                        <img src="@obra.Imagenes.First().RutaImagen"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/400x200"
                             class="card-img-top" />
                    }

                    <div class="card-body">

                        <span class="badge bg-primary">
                            @obra.Estado
                        </span>

                        <h5 class="mt-3">
                            @obra.Nombre
                        </h5>

                        <p class="text-muted">
                            @obra.Ubicacion
                        </p>

                        <p>
                            <strong>Presupuesto:</strong>
                            S/ @obra.Presupuesto
                        </p>

                        <p>
                            <strong>Inicio:</strong>
                            @obra.FechaInicio.ToString("dd/MM/yyyy")
                        </p>

                        @if (obra.FechaFin != null)
                        {
                            <p>
                                <strong>Fin:</strong>
                                @obra.FechaFin?.ToString("dd/MM/yyyy")
                            </p>
                        }

                        <a href="#"
                           class="btn btn-dark w-100">
                            Ver Detalles
                        </a>

                    </div>
                </div>

            </div>
        }

    </div>
</div>
