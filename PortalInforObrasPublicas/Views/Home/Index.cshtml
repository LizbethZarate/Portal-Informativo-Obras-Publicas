@model List<PortalInforObrasPublicas.Models.Obra>

@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/obra.css" asp-append-version="true" />

<div class="hero">
    <div class="container">
        <h1 class="fw-bold">Sistema de Gestión de Obras Públicas</h1>
        <p>Consulta el estado de proyectos y reporta problemas.</p>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>Total de Obras</h6>
                    <h3>@Model.Count</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>En Ejecución</h6>
                    <h3>
                        @Model.Count(o => o.Estado == "En ejecución")
                    </h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>Inversión Total</h6>
                    <h3>
                        S/ @Model.Sum(o => o.Presupuesto).ToString("N2")
                    </h3>
                </div>
            </div>
        </div>
        <div class="search-box d-flex gap-2 mt-4">
            <input type="text" class="form-control" placeholder="Buscar por nombre o ubicación..." />
            <select class="form-select w-auto">
                <option>Todos</option>
                <option>En ejecución</option>
                <option>Finalizado</option>
            </select>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h4 class="fw-bold">Obras Públicas del Distrito</h4>

    <div class="row mt-4">

        @foreach (var obra in Model)
        {
            var badgeClass = obra.Estado == "En ejecución" ? "estado-ejecucion" :
            obra.Estado == "Finalizada" ? "estado-finalizada" :
            "estado-pendiente";

            var avanceClass = obra.Estado == "En ejecución" ? "avance-ejecucion" :
            obra.Estado == "Finalizada" ? "avance-finalizada" :
            "avance-pendiente";

            <div class="col-md-4 mb-4">
                <div class="card obra-card h-100">

                    @if (obra.Imagenes != null && obra.Imagenes.Any())
                    {
                        <img src="@obra.Imagenes.First().RutaImagen"
                             class="card-img-top obra-img" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/400x220"
                             class="card-img-top obra-img" />
                    }

                    <div class="card-body obra-body">

                        <span class="estado-badge @badgeClass">
                            @obra.Estado
                        </span>

                        <h5 class="obra-title mt-3">
                            @obra.Nombre
                        </h5>

                        <p class="obra-location">
                            <i class="bi bi-geo-alt"></i>
                            @obra.Ubicacion
                        </p>

                        <div class="avance-box">
                            <div class="d-flex justify-content-between">
                                <span>Avance</span>
                                <strong>@obra.Avance%</strong>
                            </div>

                            <div class="avance-barra">
                                <div class="avance-progreso @avanceClass"
                                     style="width:@obra.Avance%">
                                </div>
                            </div>
                        </div>

                        <div class="presupuesto-box">
                            <span>Presupuesto:</span>
                            <strong>S/ @obra.Presupuesto.ToString("N2")</strong>
                        </div>

                        <hr />

                        <a href="#"
                           class="btn btn-dark w-100">
                            Ver Detalles
                        </a>

                    </div>
                </div>
            </div>
        }

    </div>
</div>
