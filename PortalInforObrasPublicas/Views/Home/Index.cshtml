@model List<PortalInforObrasPublicas.Models.Obra>

@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/obra.css" />

<div class="hero">
    <div class="container">
        <h1 class="fw-bold">Sistema de Gestión de Obras Públicas</h1>
        <p>Consulta el estado de proyectos y reporta problemas.</p>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>Total de Obras</h6>
                    @*  <h3>8</h3> *@
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>En Ejecución</h6>
                    @* <h3>5</h3> *@
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h6>Inversión Total</h6>
                    @* <h3>S/ 29.85M</h3> *@
                </div>
            </div>
        </div>
        <div class="search-box d-flex gap-2 mt-4">
            <input type="text" class="form-control" placeholder="Buscar por nombre o ubicación..." />
            <select class="form-select w-auto">
                <option>Todos</option>
                <option>En ejecución</option>
                <option>Finalizado</option>
            </select>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h4 class="fw-bold">Obras Públicas del Distrito</h4>

    @* --- COMPONENTE: LISTADO DE OBRAS --- *@
    <div class="obras-container">
        @foreach (var obra in Model)
        {
            <article class="obra-item" style="border: 1px solid #ccc; padding: 15px; margin-bottom: 10px;">
                <span class="status">@obra.Estado</span>
            <h3>@obra.Nombre</h3>
            <p>📍 @obra.Ubicacion</p>

            <div class="info-avance">
                <p>Avance: <strong>45%</strong></p>
                <p>Presupuesto: <strong>S/ @obra.Presupuesto</strong></p>
            </div>

            <a asp-controller="Obra"
               asp-action="Detalle"
               asp-route-id="@obra.IdObra"
               class="btn-detalle"
               style="display: inline-block; padding: 10px; background: #000; color: #fff; text-decoration: none;">
                Ver Detalles
            </a>
        </article>
        }

        <article class="obra-item" style="border: 1px solid #ccc; padding: 15px; margin-bottom: 10px;">
            <span class="status">En Ejecución</span>
            <h3>Construcción de Parque Recreativo Los Cedros</h3>
            <p>📍 Urbanización Los Cedros</p>

            <div class="info-avance">
                <p>Avance: <strong>30%</strong></p>
                <p>Presupuesto: <strong>S/ 1.20M</strong></p>
            </div>

            <a asp-controller="Obras"
               asp-action="Detalle"
               asp-route-id="2"
               class="btn-detalle"
               style="display: inline-block; padding: 10px; background: #000; color: #fff; text-decoration: none;">
                Ver Detalles
            </a>
        </article>

        <article class="obra-item" style="border: 1px solid #ccc; padding: 15px; margin-bottom: 10px;">
            <span class="status">Planificación</span>
            <h3>Remodelación de Mercado Municipal</h3>
            <p>📍 Calle Real 456</p>

            <div class="info-avance">
                <p>Avance: <strong>5%</strong></p>
                <p>Presupuesto: <strong>S/ 3.50M</strong></p>
            </div>

            <a asp-controller="Obras"
               asp-action="Detalle"
               asp-route-id="3"
               class="btn-detalle"
               style="display: inline-block; padding: 10px; background: #000; color: #fff; text-decoration: none;">
                Ver Detalles
            </a>
        </article>

    </div>

    @* <div class="row mt-4">
        <div class="col-md-4">
            <div class="card obra-card">
                <img src="https://picsum.photos/400/200" class="card-img-top" />

                <div class="card-body">
                    <span class="badge bg-primary">En ejecución</span>

                    <h5 class="mt-2">Mejoramiento de Av. Víctor Larco</h5>
                    <p class="text-muted">Av. Víctor Larco</p>

                    <div class="d-flex justify-content-between">
                        <small>Avance</small>
                        <small>45%</small>
                    </div>

                    <div class="progress mb-2">
                        <div class="progress-bar" style="width:45%"></div>
                    </div>

                    <p><strong>Presupuesto:</strong> S/ 8.50M</p>

                    <a href="#" class="btn btn-dark w-100">Ver Detalles</a>
                </div>
            </div>
        </div>
    </div> *@
</div>
